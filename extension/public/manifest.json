{
  "manifest_version": 3,
  "name": "CodePilot",
  "version": "0.1.0",
  "description": "Universal Browser-Based Coding Assistant",
  "action": {
    "default_popup": "index.html",
    "default_title": "CodePilot"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://www.codechef.com/*",
    "https://*.codechef.com/*",
    "https://www.hackerrank.com/*",
    "https://*.hackerrank.com/*",
    "https://codepilot-6hi8.onrender.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
